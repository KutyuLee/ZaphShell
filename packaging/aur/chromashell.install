post_install() {
    echo ""
    echo "==> ChromaShell files are installed in /usr/share/chromashell"
    echo "==> Run the following as your user to configure ~/.config/quickshell, Hyprland, wallpapers, and optional default apps:"
    echo "    chromashell-setup"
    echo ""
}

post_upgrade() {
    echo ""
    echo "==> Run 'chromashell-setup' as your user to update ~/.config/quickshell and ~/.config/hypr/quickshell.* copies."
    echo ""
}
